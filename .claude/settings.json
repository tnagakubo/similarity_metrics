{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/remind-suits-on-prompt.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/validate-paper-request.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/check-suits-update.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/check-suits-lines.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/check-suits-lines.sh"
          }
        ]
      }
    ]
  }
}
