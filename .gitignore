# LaTeX compile artifacts (build products, regenerated by pdflatex/bibtex)
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.log
*.nav
*.out
*.pag
*.snm
*.synctex.gz
*.toc

# Claude Code worktree directories (transient)
.claude/worktrees/

# Local Claude Code settings (user-specific)
.claude/settings.local.json

# Claude Code runtime state (pre-compaction snapshots)
.claude/state/

# Claude Code temp dirs used by skills (/process-paper images)
.claude/tmp/

# Python bytecode from scripts/
__pycache__/
